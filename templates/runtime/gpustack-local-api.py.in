#!/usr/bin/env python3
"""以本机管理员短期会话调用 GPUStack，凭据仅在进程内使用，不写入日志或文件。"""
import argparse
import json
from pathlib import Path
import subprocess
import urllib.request

AUTH = '''from datetime import timedelta
from pathlib import Path
from gpustack.security import JWTManager
from gpustack.api.auth import SESSION_COOKIE_NAME
manager=JWTManager(Path('/var/lib/gpustack/jwt_secret_key').read_text().strip(),expires_delta=timedelta(minutes=5))
print(SESSION_COOKIE_NAME+'='+manager.create_jwt_token(@@ADMIN_PY@@))
'''


def call(method, route, body=None):
    """会话来自既有本机管理员；不修改密码，不保存长效 API 密钥。"""
    cookie = subprocess.check_output(['docker', 'exec', '-i', @@SERVER_PY@@, 'python', '-'], input=AUTH.encode()).decode().strip()
    request = urllib.request.Request(@@MANAGEMENT_URL_PY@@ + route,
        data=json.dumps(body).encode() if body is not None else None,
        headers={'Cookie': cookie, 'Content-Type': 'application/json'}, method=method)
    with urllib.request.urlopen(request, timeout=45) as response:
        data = response.read()
        return json.loads(data) if data else None



def private_output(value):
    """运行结果只写到私有目录；显式指定输出也不能写回源码仓库。"""
    path = Path(value)
    if not path.is_absolute():
        path = Path(@@ROOT_PY@@) / path
    config = json.loads((Path(@@ROOT_PY@@) / 'switch-config.json').read_text())
    repository = Path(config['source_repository']).resolve()
    if path.is_symlink() or path.resolve().is_relative_to(repository):
        raise ValueError('运行结果不能写入源码仓库')
    return str(path)



def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('method')
    parser.add_argument('route')
    parser.add_argument('--body')
    parser.add_argument('--output')
    args = parser.parse_args()
    if getattr(args, 'output', None): args.output = private_output(args.output)
    data = call(args.method, args.route, json.loads(Path(args.body).read_text()) if args.body else None)
    if args.output:
        path = Path(args.output)
        path.write_text(json.dumps(data, ensure_ascii=False, indent=2))
        path.chmod(0o600)
        print(json.dumps({'saved': str(path), 'method': args.method, 'route': args.route}))
    else:
        print(json.dumps(data, ensure_ascii=False))


if __name__ == '__main__':
    main()
