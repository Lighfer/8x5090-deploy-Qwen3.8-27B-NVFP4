{
  "source": "local_path",
  "local_path": "@@MODEL_DIR@@",
  "name": "@@MODEL_NAME@@",
  "replicas": 0,
  "distributed_inference_across_workers": false,
  "worker_selector": {
    "node": "@@WORKER_LABEL@@"
  },
  "backend": "vLLM",
  "backend_parameters": [
    "--trust-remote-code",
    "--dtype=bfloat16",
    "--distributed-executor-backend=mp",
    "--attention-backend=FLASHINFER",
    "--mamba-backend=triton",
    "--gdn-prefill-backend=flashinfer",
    "--kv-cache-dtype=nvfp4",
    "--max-model-len=204800",
    "--enable-chunked-prefill",
    "--enable-prefix-caching",
    "--mamba-cache-mode=align",
    "--mamba-ssm-cache-dtype=bfloat16",
    "--limit-mm-per-prompt={\"image\":64,\"video\":0}",
    "--reasoning-parser=qwen3",
    "--enable-auto-tool-choice",
    "--tool-call-parser=qwen3_coder",
    "--override-generation-config={\"temperature\":1.0,\"top_p\":0.95,\"top_k\":20}",
    "--default-chat-template-kwargs={\"enable_thinking\":true,\"preserve_thinking\":true,\"reasoning_effort\":\"xhigh\"}",
    "--enable-prompt-tokens-details",
    "--enable-batch-sharded-sampling",
    "--api-server-count=1",
    "--mm-processor-cache-gb=0",
    "--speculative-config={\"method\":\"mtp\",\"num_speculative_tokens\":3,\"disable_eagle_block_drop\":true}",
    "--tensor-parallel-size=2",
    "--gpu-memory-utilization=0.8714",
    "--max-num-batched-tokens=1536",
    "--max-num-seqs=12",
    "--block-size=1536",
    "--mamba-block-size=1536",
    "--mm-processor-kwargs={\"images_kwargs\":{\"size\":{\"shortest_edge\":65536,\"longest_edge\":1048576}}}",
    "--mm-encoder-tp-mode=weights",
    "--mm-processor-device=cpu",
    "--no-skip-mm-profiling"
  ],
  "image_name": "@@RUNTIME_IMAGE@@",
  "env": {
    "VLLM_SSM_CONV_STATE_LAYOUT": "DS",
    "MALLOC_ARENA_MAX": "2",
    "MALLOC_TRIM_THRESHOLD_": "131072",
    "CUDA_DEVICE_ORDER": "PCI_BUS_ID",
    "CUDA_MODULE_LOADING": "LAZY",
    "PYTHONHASHSEED": "0",
    "NCCL_P2P_DISABLE": "0",
    "NCCL_P2P_LEVEL": "SYS",
    "VLLM_USE_V2_MODEL_RUNNER": "1",
    "VLLM_FLASHINFER_WORKSPACE_BUFFER_SIZE": "536870912",
    "TORCHINDUCTOR_COMPILE_THREADS": "4",
    "MAX_JOBS": "4",
    "FLASHINFER_NUM_COMPILE_JOBS": "4",
    "UCX_CUDA_IPC_CACHE": "n",
    "VLLM_KV_CACHE_LAYOUT": "LBNHC",
    "VLLM_HTTP_TIMEOUT_KEEP_ALIVE": "120",
    "UCX_CUDA_IPC_ENABLE_GET_ZCOPY": "on",
    "NIXL_SHARE_WORKER_PID": "1",
    "FLASHINFER_WORKSPACE_BASE": "/var/lib/gpustack/cache/e4a5b5537-opt-20261028/flashinfer",
    "VLLM_SM12X_DRAFT_UB_PLAN": "0",
    "VLLM_LOG_STATS_INTERVAL": "3",
    "VLLM_WORKER_MULTIPROC_METHOD": "spawn",
    "CUTE_DSL_CACHE_DIR": "/var/lib/gpustack/cache/e4a5b5537-opt-20261028/cute",
    "CUDA_CACHE_PATH": "/var/lib/gpustack/cache/e4a5b5537-opt-20261028/cuda"
  },
  "restart_on_error": false,
  "extended_kv_cache": {
    "enabled": false
  },
  "roles": [
    {
      "name": "prefill",
      "replicas": 2,
      "backend_parameters": [
        "--trust-remote-code",
        "--dtype=bfloat16",
        "--distributed-executor-backend=mp",
        "--attention-backend=FLASHINFER",
        "--mamba-backend=triton",
        "--gdn-prefill-backend=flashinfer",
        "--kv-cache-dtype=nvfp4",
        "--max-model-len=204800",
        "--enable-chunked-prefill",
        "--enable-prefix-caching",
        "--mamba-cache-mode=align",
        "--mamba-ssm-cache-dtype=bfloat16",
