#!/usr/bin/env python3
"""只读比较 GPUStack 原生角色继承结果与真实 P/D 进程，不输出平台或数据库凭据。"""
import argparse
import datetime
import json
from pathlib import Path
import re
import subprocess
import urllib.request


# 本机已验证的固定环境同时包含原服务的CUDA、NCCL和编译选项，以及PD传输所需设置。
# 可见卡由GPUStack按实例分配，另外记录，不把一个实例的CUDA编号写成所有副本的共同要求。
EXPECTED_ENVIRONMENT = {
    'CUDA_DEVICE_ORDER': 'PCI_BUS_ID', 'CUDA_MODULE_LOADING': 'LAZY', 'PYTHONHASHSEED': '0',
    'NCCL_P2P_DISABLE': '0', 'NCCL_P2P_LEVEL': 'SYS', 'VLLM_USE_V2_MODEL_RUNNER': '1',
    'VLLM_FLASHINFER_WORKSPACE_BUFFER_SIZE': '536870912',
    'TORCHINDUCTOR_COMPILE_THREADS': '4', 'MAX_JOBS': '4', 'FLASHINFER_NUM_COMPILE_JOBS': '4',
    'VLLM_SSM_CONV_STATE_LAYOUT': 'DS', 'VLLM_KV_CACHE_LAYOUT': 'LBNHC', 'UCX_CUDA_IPC_CACHE': 'n',
    'UCX_CUDA_IPC_ENABLE_GET_ZCOPY': 'on', 'NIXL_SHARE_WORKER_PID': '1',
    'VLLM_HTTP_TIMEOUT_KEEP_ALIVE': '120',
}

QUERY=r'''
import json,os,subprocess
from pathlib import Path
from gpustack.schemas.models import Model,role_effective_model
env=dict(os.environ,PGPASSWORD=Path('/var/lib/gpustack/postgres_root_pass').read_text().strip())
sql="""SELECT json_build_object('model',(SELECT row_to_json(m) FROM models m WHERE id=@@MODEL_ID@@),
'cluster_name',(SELECT c.name FROM clusters c JOIN models m ON m.cluster_id=c.id WHERE m.id=@@MODEL_ID@@),
'instances',(SELECT json_agg(row_to_json(i)) FROM (SELECT id,name,role,state,worker_ip,port,gpu_indexes FROM model_instances
WHERE model_id=@@MODEL_ID@@ AND role IN ('prefill','decode','router') AND deleted_at IS NULL ORDER BY role) i))"""
p=subprocess.run(['psql','-X','-h','127.0.0.1','-U','root','-d','gpustack','-At','-c',sql],
    env=env,capture_output=True,text=True,check=True,timeout=15)
data=json.loads(p.stdout)
# 数据库枚举列保存成员名，模型 API 使用枚举值；这里只规范化已核实的三个小写枚举。
for field in ['source','placement_strategy','access_policy']:
    if isinstance(data['model'].get(field),str):data['model'][field]=data['model'][field].lower()
model=Model.model_validate(data['model'])
fields=['name','source','local_path','replicas','backend','image_name','backend_parameters','env',
        'worker_selector','restart_on_error','extended_kv_cache','roles','disaggregation','enable_model_route',
        'distributed_inference_across_workers','gpu_selector']
export=model.model_dump(mode='json',include=set(fields),exclude_none=True)
export['cluster_name']=data['cluster_name']
effective={role:role_effective_model(model,role).backend_parameters for role in ['prefill','decode']}
effective_images={role:role_effective_model(model,role).image_name for role in ['prefill','decode']}
replicas={role:role_effective_model(model,role).replicas for role in ['prefill','decode']}
cache_ids=sorted({r.extended_kv_cache.cache_service_id for r in model.roles
    if r.extended_kv_cache and r.extended_kv_cache.enabled and r.extended_kv_cache.cache_service_id})
cache_services=[]
if cache_ids:
    # 沿用只读数据库连接，按模型实际引用的服务读取声明，不拿待应用文件冒充回滚状态。
    cache_sql='SELECT COALESCE(json_agg(json_build_object(\'id\',id,\'config\',config)),\'[]\'::json) FROM cache_services WHERE id IN ('+','.join(str(int(i)) for i in cache_ids)+')'
    cached=subprocess.run(['psql','-X','-h','127.0.0.1','-U','root','-d','gpustack','-At','-c',cache_sql],
        env=env,capture_output=True,text=True,check=True,timeout=15)
    cache_services=json.loads(cached.stdout)
print(json.dumps(dict(model_export=export,effective=effective,effective_images=effective_images,expected_replicas=replicas,instances=data['instances'],
    cache_services=cache_services,decode_override=next(r.backend_parameters for r in model.roles if r.name=='decode'))))
'''


def options(arguments):
    """统一等号和独立参数形式；仅 JSON 值在需要时解除启动器保留的引号转义。"""
    result={};index=0
    while index<len(arguments):
        value=arguments[index]
        if not value.startswith('--'):index+=1;continue
        key,separator,assigned=value.partition('=')
        if not separator and index+1<len(arguments) and not arguments[index+1].startswith('--'):
            index+=1;assigned=arguments[index]
        elif not separator:assigned=True
        if isinstance(assigned,str) and assigned.startswith(('{','[')):
            try:assigned=json.loads(assigned)
            except json.JSONDecodeError:assigned=json.loads(assigned.replace('\\"','"'))
        result[key]=assigned;index+=1
    return result


def command_model_path(arguments):
    """同时识别vLLM serve位置参数与旧API启动器的--model，拒绝只凭对外别名验收权重。"""
    supplied = options(arguments).get('--model')
    if isinstance(supplied, str):
        return supplied
    for index, item in enumerate(arguments[:-1]):
        if item == 'serve' and arguments[index + 1].startswith('/'):
            return arguments[index + 1]
    return None


def router_evidence(configured, logs, info, workers, expected_members):
    """用启动记录或不可变启动配置结合实时注册表核对Router，避免日志轮转误报。

    注册表必须与平台的全部P/D实例逐地址相等；缺失日志可以由固定镜像的启动参数
    佐证，已有但冲突的策略日志则不能降级忽略。实际策略日志值保持原样记录，不能
    把配置值伪写成运行时观测值。镜像内容身份由调用方单独核对。
    """
    declared = {role: configured.get('--' + role + '-policy', configured.get('--policy', 'cache_aware'))
                for role in ('prefill', 'decode')}
    observed = re.findall(r'PD stage policies active: prefill=([a-z_0-9]+), decode=([a-z_0-9]+)', logs)
    actual = dict(zip(('prefill', 'decode'), observed[-1])) if observed else None
    healthy = {(row.get('worker_type'), row.get('url', '').rstrip('/')) for row in workers
               if row.get('is_healthy') is True}
    command_pd = (configured.get('--enable-igw') is True and configured.get('--vllm-pd-disaggregation') is True
                  and configured.get('--kv-connector') == 'nixl')
    live_pd = (info.get('router_manager') is True and healthy == expected_members
               and {role for role, _ in healthy} == {'prefill', 'decode'})
    native = 'Multi-router mode enabled (enable_igw=true)' in logs or (command_pd and live_pd)
    matches = actual == declared if actual is not None else command_pd and live_pd
    return {'declared_stage_policies': declared, 'actual_stage_policies': actual,
            'stage_policies_match': matches, 'native_multi_router_mode': native,
            'policy_evidence': 'startup-log' if actual is not None else 'fixed-image-command-and-live-members',
            'live_members_match': healthy == expected_members, 'runtime_info': info}


def cache_gpu_scope(service, allowed_gpus, prefill_gpus):
    """缓存必须精确遵守平台声明，并覆盖全部P，且不能看到本方案以外的预留卡。

    旧版声明全部模型GPU，新版只声明P的GPU；二者都依据各自真实服务定义核验，
    不能把D卡必须可见作为CPU共享缓存成立的条件，也不能接受任意非空子集。
    """
    raw=service['config']['env']['CUDA_VISIBLE_DEVICES']
    values=[int(item.strip()) for item in raw.split(',') if item.strip()]
    if not values or len(values)!=len(set(values)) or not set(prefill_gpus)<=set(values)<=set(allowed_gpus):
        raise RuntimeError('缓存GPU声明未覆盖P、包含预留卡或存在重复')
    return sorted(values)



def fp8_runtime_evidence(expected, model_name, model_list, metrics):
    """由普通模型接口和引擎指标确认实际值，不能只检查启动命令中的声明。

    框架可能自动上调不合适的管理块。指标来自引擎初始化后的CacheConfig，
    因而可以发现命令写1024、实际却使用其他块大小的情况；不启用开发接口。
    缺失或矛盾时终止验证，由正式事务执行器恢复原部署后再恢复入口。
    """
    cards = [row for row in model_list.get('data', []) if row.get('id') == model_name]
    wanted_length = int(expected['--max-model-len'])
    if len(cards) != 1 or cards[0].get('max_model_len') != wanted_length:
        raise RuntimeError('FP8实际上下文与P/D共同固定上限不一致')
    rows = []
    for line in metrics.splitlines():
        match = re.fullmatch(r'vllm:cache_config_info\{(.*)\}\s+(\S+)(?:\s+\S+)?', line.strip())
        if match and float(match[2]) == 1:
            labels = {name: json.loads('"' + value + '"') for name, value in
                      re.findall(r'([a-zA-Z_][a-zA-Z_0-9]*)="((?:\\.|[^"\\])*)"', match[1])}
            rows.append(labels)
    if not rows:
        raise RuntimeError('FP8实际缓存配置指标缺失，不能只凭启动参数恢复访问')
    wanted = {'block_size': str(expected['--block-size']),
              'mamba_block_size': str(expected['--mamba-block-size']),
              'cache_dtype': 'fp8_e4m3', 'mamba_ssm_cache_dtype': 'bfloat16'}
    for row in rows:
        if any(row.get(key) != value for key, value in wanted.items()):
            raise RuntimeError('FP8引擎实际缓存布局与正式配方不一致')
        if not row.get('num_gpu_blocks', '').isdigit() or int(row['num_gpu_blocks']) <= 1:
            raise RuntimeError('FP8引擎没有足够的实际GPU缓存块')
    return {'passed': True, 'max_model_len': wanted_length,
            'cache_config': [{key: row[key] for key in (*wanted, 'num_gpu_blocks')} for row in rows],
            'evidence_source': '/v1/models and /metrics; no development endpoints'}


def private_output(value):
    """运行结果只写到私有目录；显式指定输出也不能写回源码仓库。"""
    path = Path(value)
    if not path.is_absolute():
        path = Path(@@ROOT_PY@@) / path
    config = json.loads((Path(@@ROOT_PY@@) / 'switch-config.json').read_text())
    repository = Path(config['source_repository']).resolve()
    if path.is_symlink() or path.resolve().is_relative_to(repository):
        raise ValueError('运行结果不能写入源码仓库')
    return str(path)



def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--output',default='P-D参数核验.json')
    parser.add_argument('--export',default='pd-model-live.json')
    args=parser.parse_args()
    if getattr(args, 'output', None): args.output = private_output(args.output)
    if getattr(args, 'export', None): args.export = private_output(args.export)
    data=json.loads(subprocess.check_output(['docker','exec',@@SERVER_PY@@,'python','-c',QUERY],text=True))
    Path(args.export).write_text(json.dumps(data['model_export'],ensure_ascii=False,indent=2))
    checks=[]
    assigned_gpus=[]
    # 显式指定卡时使用角色选择的并集；默认八卡方案仍完整检查0至7。
    declared = [(r.get('gpu_selector') or {}).get('gpu_ids') or [] for r in data['model_export']['roles'] if r['name'] in ('prefill','decode')]
    expected_gpus = sorted({int(g.rsplit(':',1)[1]) for ids in declared for g in ids}) if all(declared) else json.loads((Path(@@ROOT_PY@@) / 'switch-config.json').read_text())['hardware_gpu_ids']
    worker=json.loads(subprocess.check_output(['docker','inspect',@@WORKER_PY@@],text=True))[0]
    worker_pid_namespace=str((Path('/proc') / str(worker['State']['Pid']) / 'ns/pid').readlink())
    host_pid_namespace=str(Path('/proc/self/ns/pid').readlink())
    for role in ['prefill','decode']:
        instances=[i for i in data['instances'] if i['role']==role and str(i['state']).lower()=='running']
        if len(instances)!=data['expected_replicas'][role]:raise RuntimeError('Unexpected running replica count for '+role)
        for instance in instances:
            name=instance['name']+'-run-0'
            inspect=json.loads(subprocess.check_output(['docker','inspect',name],text=True))[0]
            # 共享PID空间后，容器里的PID 1属于Worker；读取Docker记录的实际入口进程，核对真正的vLLM参数。
            command=(Path('/proc') / str(inspect['State']['Pid']) / 'cmdline').read_bytes().decode().split('\0')
            actual=options(command);expected=options(data['effective'][role])
            actual_model_path=command_model_path(command)
            expected_model_path=data['model_export']['local_path']
            model_path_matches=actual_model_path==expected_model_path
            differences={key:dict(expected=value,actual=actual.get(key)) for key,value in expected.items() if actual.get(key)!=value}
            declared_image=data['effective_images'][role]
            declared_image_id=subprocess.check_output(['docker','image','inspect','-f','{{.Id}}',declared_image],text=True).strip()
            # 旧镜像通过草稿规划补丁减少同步；新版直接使用原生 NVFP4/XQA 实现。
            # 依据正在运行的包版本核对，不能把已删除的自定义环境开关当作新版 MTP 的证据。
            vllm_version=subprocess.check_output(['docker','exec',name,'python3','-c',
                "import importlib.metadata; print(importlib.metadata.version('vllm'))"],text=True).strip()
            expected_environment=dict(EXPECTED_ENVIRONMENT)
            if vllm_version.startswith('0.31.'):
                expected_environment['VLLM_SM12X_DRAFT_UB_PLAN']='1'
            # 仅接受已固定提交并核对实际镜像身份的版本，保留旧版本用于事务回退。
            elif vllm_version not in ('0.32.0', '0.32.1rc1.dev466+ge4a5b5537'):
                raise RuntimeError('Unverified vLLM version: '+vllm_version)
            elif data['model_export'].get('env',{}).get('FLASHINFER_WORKSPACE_BASE'):
                # 新配置将内核保存在Worker持久卷；兼容回滚到尚未迁移缓存路径的首轮0.32.0快照。
                expected_environment['FLASHINFER_WORKSPACE_BASE']=data['model_export']['env']['FLASHINFER_WORKSPACE_BASE']
                expected_environment['VLLM_SM12X_DRAFT_UB_PLAN']='0'
            allowed=set(expected_environment) | {'CUDA_VISIBLE_DEVICES','VLLM_SM12X_DRAFT_UB_PLAN','FLASHINFER_WORKSPACE_BASE'}
            environment=dict(entry.split('=',1) for entry in inspect['Config']['Env'] if entry.split('=',1)[0] in allowed)
            environment_differences={key:dict(expected=value,actual=environment.get(key))
                for key,value in expected_environment.items() if environment.get(key)!=value}
            if environment.get('VLLM_HTTP_TIMEOUT_KEEP_ALIVE') != '120':
                raise RuntimeError('Backend HTTP keep-alive must exceed the Router 50-second idle pool timeout')
            pid_namespace=str((Path('/proc') / str(inspect['State']['Pid']) / 'ns/pid').readlink())
            # 比较内核实际命名空间；仅看PidMode字符串无法证明Docker完成了共享，也不能把host模式当作等效验收。
            nixl_namespace_matches=(pid_namespace==worker_pid_namespace and pid_namespace!=host_pid_namespace
                and environment.get('NIXL_SHARE_WORKER_PID')=='1'
                and environment.get('UCX_CUDA_IPC_ENABLE_GET_ZCOPY')=='on')
            # 每个实例核对原生 TP 占卡数量，并单独记录实际卡号，避免多副本共用同一组 GPU。
            indices=instance.get('gpu_indexes') or []
            assigned_gpus.extend(indices)
            role_spec=next(r for r in data['model_export']['roles'] if r['name']==role)
            selected=(role_spec.get('gpu_selector') or {}).get('gpu_ids') or []
            allowed_gpus={int(g.rsplit(':',1)[1]) for g in selected} if selected else set(expected_gpus)
            gpu_count_matches=len(indices)==int(expected['--tensor-parallel-size']) and set(indices)<=allowed_gpus
            speculative=actual.get('--speculative-config') or {}
            mtp_enabled=speculative.get('method')=='mtp' and speculative.get('num_speculative_tokens')==3
            if vllm_version.startswith('0.31.'):
                mtp_enabled=mtp_enabled and environment.get('VLLM_SM12X_DRAFT_UB_PLAN')=='1'
            # 共享缓存只接入 Prefill；两阶段始终保留原生 NIXL 传输，不能用 LMCache 代替 PD。
            transfer=json.dumps(actual.get('--kv-transfer-config',{}))
            cache=next(r.get('extended_kv_cache',{}) for r in data['model_export']['roles'] if r['name']==role) or {}
            expected_shared=role=='prefill' and cache.get('enabled',False)
            connectors_match='NixlConnector' in transfer and ('LMCacheMPConnector' in transfer)==expected_shared
            runtime_evidence = None
            if expected.get('--quantization') == 'fp8':
                # 在切换已排空、引擎就绪后才运行；仅GET，不触发推理或在线校准。
                base = 'http://' + instance['worker_ip'] + ':' + str(instance['port'])
                with urllib.request.urlopen(base + '/v1/models', timeout=15) as response:
                    runtime_models = json.load(response)
                with urllib.request.urlopen(base + '/metrics', timeout=15) as response:
                    runtime_metrics = response.read().decode()
                runtime_evidence = fp8_runtime_evidence(expected, data['model_export']['name'],
                                                        runtime_models, runtime_metrics)
                if expected_shared:
                    services = [s for s in data['cache_services'] if s['id'] == cache['cache_service_id']]
                    if (len(services) != 1 or services[0]['config']['fields']['chunk_size'] != cache['chunk_size']
                            or cache['chunk_size'] % int(expected['--block-size'])):
                        raise RuntimeError('FP8运行中的CPU池分块与P关联或实际GPU块不一致')
            checks.append(dict(role=role,instance_id=instance['id'],container=name,image_id=inspect['Image'],vllm_version=vllm_version,
                declared_flags=len(expected),all_declared_parameters_present=not differences,differences=differences,
                actual_model_path=actual_model_path,expected_model_path=expected_model_path,model_path_matches=model_path_matches,
                pid_namespace=pid_namespace,worker_pid_namespace=worker_pid_namespace,nixl_namespace_matches=nixl_namespace_matches,
                actual_parameters=actual,selected_environment=environment,http_port=instance['port'],gpu_indexes=indices,
                environment_matches=not environment_differences,environment_differences=environment_differences,
                gpu_count_matches=gpu_count_matches,mtp_enabled=mtp_enabled,connectors_match=connectors_match,
                declared_image=declared_image,declared_image_id=declared_image_id,image_matches=inspect['Image']==declared_image_id,
                fp8_runtime_evidence=runtime_evidence))
    # Router 的进程会重写 argv 标题，不能只看 /proc/1/cmdline；同时核对角色镜像与原生启动模式。
    router_instances=[i for i in data['instances'] if i['role']=='router' and str(i['state']).lower()=='running']
    if len(router_instances)!=1:raise RuntimeError('Expected one running Router instance')
    router_name=router_instances[0]['name']+'-run-0'
    router_inspect=json.loads(subprocess.check_output(['docker','inspect',router_name],text=True))[0]
    router_image=router_inspect['Image']
    router_declared=next(row.get('image_name') for row in data['model_export']['roles'] if row['name']=='router')
    expected_router_image=subprocess.check_output(['docker','image','inspect','-f','{{.Id}}',router_declared],text=True).strip()
    logs=subprocess.check_output(['docker','logs',router_name],stderr=subprocess.STDOUT,text=True)
    configured=options(router_inspect['Config']['Cmd'])
    router_role=next(row for row in data['model_export']['roles'] if row['name']=='router')
    expected_router_parameters=options(router_role.get('backend_parameters') or [])
    router_parameter_differences={key:dict(expected=value,actual=configured.get(key))
        for key,value in expected_router_parameters.items() if configured.get(key)!=value}
    router_base='http://'+router_instances[0]['worker_ip']+':'+str(router_instances[0]['port'])
    live_router={}
    for route in ('get_server_info', 'workers'):
        with urllib.request.urlopen(router_base+'/'+route, timeout=10) as response:
            live_router[route]=json.loads(response.read())
    expected_members={(item['role'],'http://'+item['worker_ip']+':'+str(item['port']))
                      for item in data['instances'] if item['role'] in ('prefill','decode')}
    evidence=router_evidence(configured,logs,live_router['get_server_info'],live_router['workers'].get('workers',[]),expected_members)
    router=dict(container=router_name,image_id=router_image,
        declared_image=router_declared,**evidence,
        explicit_parameter_differences=router_parameter_differences,explicit_parameters_match=not router_parameter_differences,
        dedicated_image_matches=router_image==expected_router_image)
    unique_gpus=len(assigned_gpus)==len(set(assigned_gpus)) and sorted(assigned_gpus)==expected_gpus
    cache_visibility_matches=True
    expected_cache_gpus=[]
    shared=any((r.get('extended_kv_cache') or {}).get('enabled') for r in data['model_export']['roles'])
    if shared:
        # 对照模型实际引用服务的声明，而非要求CPU池额外看到D的显卡。
        prefill_gpus={g for item in checks if item['role']=='prefill' for g in item['gpu_indexes']}
        if len(data['cache_services'])!=1:raise RuntimeError('共享缓存声明必须唯一')
        expected_cache_gpus=cache_gpu_scope(data['cache_services'][0],expected_gpus,prefill_gpus)
        cache_name=json.loads((Path(__file__).parent/'switch-config.json').read_text())['cache_name']
        names=subprocess.check_output(['docker','ps','--format','{{.Names}}'],text=True).splitlines()
        names=[n for n in names if n.startswith(cache_name+'-server-') and n.endswith('-run-0')]
        cache_visibility_matches=len(names)==1
        if names:
            cache_inspect=json.loads(subprocess.check_output(['docker','inspect',names[0]],text=True))[0]
            cache_env=dict(e.split('=',1) for e in cache_inspect['Config']['Env'])
            cache_visibility_matches=cache_visibility_matches and sorted(int(x) for x in cache_env.get('CUDA_VISIBLE_DEVICES','').split(',') if x)==expected_cache_gpus
    report=dict(at=datetime.datetime.now(datetime.timezone.utc).isoformat(),gpu_assignment_complete_and_disjoint=unique_gpus,expected_gpu_indexes=expected_gpus,cache_gpu_visibility_matches=cache_visibility_matches,expected_cache_gpu_indexes=expected_cache_gpus,
        passed=all(c['all_declared_parameters_present'] and c['model_path_matches'] and c['gpu_count_matches'] and c['mtp_enabled'] and c['connectors_match'] and c['image_matches'] and c['nixl_namespace_matches'] and c['environment_matches'] for c in checks)
            and unique_gpus and cache_visibility_matches and router['dedicated_image_matches'] and router['native_multi_router_mode']
            and router['stage_policies_match'] and router['explicit_parameters_match'] and router['live_members_match'],
        inheritance_source='GPUStack v2.3.0 gpustack.schemas.models.role_effective_model',
        decode_role_override=data['decode_override'],decode_inherits_top=data['decode_override'] is None,checks=checks,router=router)
    Path(args.output).write_text(json.dumps(report,ensure_ascii=False,indent=2))
    print(json.dumps(dict(passed=report['passed'],checks=[{k:c[k] for k in ['role','instance_id','declared_flags','differences']} for c in checks])))
    if not report['passed']:raise RuntimeError('Declared and actual parameters differ')


if __name__=='__main__':main()
