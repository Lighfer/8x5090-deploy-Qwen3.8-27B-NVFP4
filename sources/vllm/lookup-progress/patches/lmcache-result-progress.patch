+
+    def progress_pending_lookups(
+        self, max_requests: int = 64, time_budget_s: float = 0.001
+    ) -> int:
+        """限量推进已提交查询，不要求本轮还有可分配的计算token。
+
+        连接器元数据回调在计算预算耗尽时仍会执行。这里复用原查询状态机，
+        保留LOOKUP确认先于状态查询的顺序；完成值留在原结果缓存中，供正式
+        准入路径读取。不会分配GPU块、改变请求状态或释放仍需导入的读锁。
+
+        未完成项轮转到队尾，完成与取消项及时移除。时间限制是调用之间检查的
+        软预算，不能强行中断单次本地操作；阻塞查询模式不进入这个推进路径。
+        """
+        if (
+            not self._nonblocking_lookup_status
+            or max_requests <= 0
+            or time_budget_s <= 0
+        ):
+            return 0
+
+        deadline = time.monotonic() + time_budget_s
+        checked = 0
+        for _ in range(min(max_requests, len(self._lookup_progress))):
+            request_id, _value = self._lookup_progress.popitem(last=False)
+            if (
+                request_id in self._pending_lookups
+                and request_id not in self._finished_lookup_results
+            ):
+                # 先放回队尾；原状态机抛错时也不丢失尚未完成的登记项。
+                self._lookup_progress[request_id] = None
+                result = self.check_lookup_result(request_id)
+                checked += 1
+                if result is not None:
+                    # 超时或服务失联的零命中回退同样固定下来，避免恢复健康后
+                    # 再次消费已经终止的状态查询；正常完成值由原状态机缓存。
+                    self._finished_lookup_results.setdefault(request_id, result)
+                    self._lookup_progress.pop(request_id, None)
+            if time.monotonic() >= deadline:
+                break
+        return checked
 
